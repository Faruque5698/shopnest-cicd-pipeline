# Backend environment configuration (copy to .env locally — NEVER commit .env)
PORT=4001
APP_ENV=development
APP_SLOT=local
GIT_COMMIT_SHA=local-dev
DEPLOYED_AT=local

# PostgreSQL connection (local only — in staging/prod injected via GitHub Secrets)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shopnest_dev
DB_USER=shopnest_user
DB_PASSWORD=replace_with_local_password
